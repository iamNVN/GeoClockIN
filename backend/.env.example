# PostgreSQL connection string. The default is the local database that `npm run dev`
# starts for you. For hosted databases (Neon, Supabase, …) keep ?sslmode=require.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/geoclockin

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string

# Port for the local API server (npm run dev).
PORT=3001
