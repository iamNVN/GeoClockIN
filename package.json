{
  "name": "geoclockin",
  "version": "0.1.0",
  "private": true,
  "description": "Location-verified employee attendance.",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend/employee",
    "frontend/admin"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n db,api,web,admin -c blue,green,cyan,magenta \"npm:dev:db\" \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:admin\"",
    "dev:db": "npm run dev:db -w backend",
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend/employee",
    "dev:admin": "npm run dev -w frontend/admin",
    "build": "npm run build -w frontend/employee && npm run build -w frontend/admin",
    "test": "npm test -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "hash-password": "npm run hash-password -w backend --"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
