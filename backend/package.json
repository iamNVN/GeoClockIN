{
  "name": "@geoclockin/backend",
  "version": "0.1.0",
  "private": true,
  "description": "GeoClockIN API — authentication, geofence verification and attendance rules.",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "dev:db": "node --env-file-if-exists=.env scripts/dev-db.mjs",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "hash-password": "node scripts/hash-password.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17"
  }
}
